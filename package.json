{
  "name": "htest.dev",
  "version": "0.1.0",
  "description": "Declarative, boilerplate-free unit testing, for everyone",
  "files": [
    "src/",
    "bin/",
    "htest.js",
    "htest.css",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bin/htest.js tests/index.js",
    "build:html": "docspire",
    "watch:html": "docspire --watch",
    "build": "npm run build:docs && npm run build:html",
    "build:docs": "npx typedoc",
    "watch:docs": "npx typedoc --watch --preserveWatchOutput",
    "watch": "npm run watch:html",
    "serve": "docspire --serve",
    "dev": "netlify dev -p 8844",
    "eslint": "npx eslint .",
    "eslint:fix": "npx eslint . --fix",
    "release": "npm login && release-it"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./check": {
      "import": "./src/check.js"
    },
    "./map": {
      "import": "./src/map.js"
    },
    "./env": {
      "import": "./src/env/index.js"
    },
    "./run": {
      "import": "./src/run.js"
    },
    "./cli": {
      "import": "./src/cli.js"
    }
  },
  "bin": {
    "htest": "bin/htest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htest-dev/htest.git"
  },
  "keywords": [],
  "author": "Lea Verou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/htest-dev/htest/issues"
  },
  "homepage": "https://htest.dev",
  "devDependencies": {
    "@stylistic/eslint-plugin": "latest",
    "docspire": "^0",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "^3.9.10",
    "prettier-plugin-brace-style": "^0.10.4",
    "prettier-plugin-merge": "^0.10.2",
    "prettier-plugin-space-before-function-paren": "^0.1.0",
    "release-it": "latest",
    "typedoc": "^0.28.20"
  },
  "dependencies": {
    "ansi-escapes": "^7.3.0",
    "diff": "^8.0.4",
    "glob": "^13.0.6",
    "oo-ascii-tree": "^1.136.0",
    "string-width": "^8.2.1"
  }
}
